library ieee;
use ieee.std_logic_1164.all;
library work;
use work.Gates.all;

entity demux is
    port(
        a,b,c,d,e : in std_logic;  -- c = Cin
        y : out std_logic
    );
end demux;

architecture struct of demux is
     -- signal s0,s1, s2,s3,s4,s5 : std_logic;
begin

	 g1 : S port map(a,b,c,d,e,y);

end struct;