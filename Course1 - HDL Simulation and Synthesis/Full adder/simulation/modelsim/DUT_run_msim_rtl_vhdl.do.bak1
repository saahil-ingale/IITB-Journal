transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vcom -93 -work work {D:/demo files/Gates.vhdl}
vcom -93 -work work {D:/demo files/DUT.vhdl}
vcom -93 -work work {D:/demo files/no_xor.vhd}

vcom -93 -work work {D:/Full adder/../demo files/Testbench.vhdl}

vsim -t 1ps -L altera -L lpm -L sgate -L altera_mf -L altera_lnsim -L maxv -L rtl_work -L work -voptargs="+acc"  Tetsbench

add wave *
view structure
view signals
run -all
